# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# vs code
.vscode/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …trừ file mẫu: `app:init` chép ra từ nó, nên nó PHẢI có trong repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client sinh ra lúc build — dựng lại được bằng `prisma generate`, không commit.
/app/generated/prisma

# Tài liệu skill do Prisma CLI tải về. `skills-lock.json` mới là thứ cần commit —
# nó ghim đúng phiên bản kèm hash.
/.agents/
/.claude/
/.windsurf/
