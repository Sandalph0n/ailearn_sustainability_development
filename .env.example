# Mẫu cấu hình. `pnpm app:init` chép file này thành `.env` nếu chưa có.
#
# `.env` KHÔNG được Prisma tự nạp — `prisma.config.ts` phải `import "dotenv/config"` mới đọc được.

# Ba giá trị dưới đây phải khớp với `compose.yaml`:
#   POSTGRES_USER → postgres · POSTGRES_PASSWORD → dev · POSTGRES_DB → ailearn
DATABASE_URL="postgresql://postgres:dev@localhost:5432/ailearn?schema=public"

# Số ngày một phiên đăng nhập tồn tại. Cookie và dòng `Session` luôn hết hạn cùng lúc.
AUTH_SESSION_TTL_DAYS="7"

# ─── Kho tệp (S3) ────────────────────────────────────────────────────────────
#
# Ở máy dev, bốn dòng dưới trỏ tới container MinIO trong `compose.yaml`.
#
# Lên AWS thì XOÁ `S3_ENDPOINT` đi — thiếu nó, SDK tự tìm S3 thật theo `S3_REGION`, và phần còn
# lại của mã nguồn không đổi một dòng nào.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="ailearn"
S3_SECRET_ACCESS_KEY="ailearn-dev-secret"
S3_BUCKET="ailearn"
