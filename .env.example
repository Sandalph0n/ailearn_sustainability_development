# Mẫu cấu hình. `pnpm app:init` chép file này thành `.env` nếu chưa có.
#
# `.env` KHÔNG được Prisma tự nạp — `prisma.config.ts` phải `import "dotenv/config"` mới đọc được.

# Ba giá trị dưới đây phải khớp với `compose.yaml`:
#   POSTGRES_USER → postgres · POSTGRES_PASSWORD → dev · POSTGRES_DB → ailearn
DATABASE_URL="postgresql://postgres:dev@localhost:5432/ailearn?schema=public"

# Số ngày một phiên đăng nhập tồn tại. Cookie và dòng `Session` luôn hết hạn cùng lúc.
AUTH_SESSION_TTL_DAYS="7"

# JWT ngắn hạn trao cho web tool. Dùng một chuỗi ngẫu nhiên ít nhất 32 byte và KHÔNG dùng chung
# với mật khẩu database hay kho tệp. Tool token hiện hết hạn sau 5 phút.
# Để trống trong template: `pnpm app:init` tự sinh 48 byte ngẫu nhiên trên từng máy.
TOOL_TOKEN_SECRET=""

# Origin của ứng dụng Lernumi chính. Tool dùng URL này để quay lại các trang đã đăng nhập.
# Production nên dùng dạng https://app.lernumi.com.
PLATFORM_ORIGIN="http://localhost:3000"

# Origin riêng để chạy code của tool. Có thể cùng trỏ tới một Next.js deployment với app chính,
# nhưng PHẢI là hostname khác để trình duyệt cô lập cookie và storage của nền tảng.
# Local dùng localhost:3000 cho app và 127.0.0.1:3000 cho tool: cùng server, khác origin.
# Production nên dùng dạng https://tools.lernumi.com.
TOOL_RUNTIME_ORIGIN="http://127.0.0.1:3000"

# ─── Kho tệp (S3) ────────────────────────────────────────────────────────────
#
# Ở máy dev, bốn dòng dưới trỏ tới container MinIO trong `compose.yaml`.
#
# Lên AWS thì XOÁ `S3_ENDPOINT` đi — thiếu nó, SDK tự tìm S3 thật theo `S3_REGION`, và phần còn
# lại của mã nguồn không đổi một dòng nào.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="ailearn"
S3_SECRET_ACCESS_KEY="ailearn-dev-secret"
# ─── Bốn bucket, bốn chính sách ──────────────────────────────────────────────
#
# Không gộp làm một, vì những thứ sau chỉ đặt được ở CẤP BUCKET chứ không đặt cho từng tệp:
# versioning, quyền công khai, mã hoá mặc định, và Object Lock.
#
#   media    ảnh đại diện, logo trường   — đè liên tục, không cần lịch sử
#   docs     `Document` trong workspace  — riêng tư, xoá được theo yêu cầu
#   tools    mã nguồn của công cụ        — bất biến, ra bản mới thay vì sửa
#   archive  buổi làm bài đã niêm phong  — CÓ Object Lock, xem ghi chú ở init.mjs
#
# Trên AWS, tên bucket là duy nhất TOÀN CẦU — `ailearn-docs` nhiều khả năng đã có người lấy.
# Vì vậy tên nằm ở đây chứ không hằng số trong mã nguồn.
S3_BUCKET_MEDIA="ailearn-media"
S3_BUCKET_DOCS="ailearn-docs"
S3_BUCKET_TOOLS="ailearn-tools"
S3_BUCKET_ARCHIVE="ailearn-archive"
