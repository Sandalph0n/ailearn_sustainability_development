/// Một LẦN chấm một lượt làm bài.
///
/// ─── Vì sao nhiều dòng cho cùng một `Attempt`, thay vì ghi đè điểm ───────────
///
/// Vì chấm lại là chuyện thường: sinh viên khiếu nại, người phụ trách môn duyệt lại, hai trợ
/// giảng chấm chéo để đối chiếu.
///
/// Ghi đè một dòng thì mất sạch lịch sử — và lịch sử chấm chính là thứ cần tới nhất khi có tranh
/// chấp điểm. Điểm cuối cùng là dòng mới nhất; các dòng trước là hồ sơ.
model Marking {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Chấm lượt làm bài nào.
  attemptId String @db.Uuid

  /// Ai chấm. Trỏ tới `User` vì người chấm cũng là một người dùng của hệ thống.
  markerId String @db.Uuid

  /// Điểm số.
  score Float

  /// Nhận xét, và những gì cần hỏi thêm khi gặp sinh viên.
  notes String?

  createdAt DateTime @default(now())

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  marker  User    @relation(fields: [markerId], references: [id])

  /// Lấy lần chấm mới nhất của một bài — truy vấn chạy thường xuyên nhất ở màn hình điểm.
  @@index([attemptId, createdAt])
}
