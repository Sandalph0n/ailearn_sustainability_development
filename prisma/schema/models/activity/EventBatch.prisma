/// Một LÔ sự kiện do công cụ gửi lên. Nơi ở của toàn bộ dữ liệu ghi nhận quá trình làm bài.
///
/// ─── Vì sao gom lô ───────────────────────────────────────────────────────────
///
/// Một bài cỡ thật sinh hàng nghìn sự kiện. Mỗi sự kiện một dòng là hàng nghìn lần ghi database
/// cho một buổi. Phát lại vốn đọc tuần tự từ đầu nên gom lô không mất gì.
///
/// ─── Siêu dữ liệu ở CỘT, nội dung ở JSONB ────────────────────────────────────
///
/// Thứ gì cần TRUY VẤN phải là cột; thứ gì chỉ công cụ mới hiểu thì vào `events`. Không link hay
/// lọc qua JSONB được.
///
/// Đó cũng là thứ khiến sau này chuyển được sang kho tệp: chỉ cột `events` đi, phần còn lại ở
/// nguyên và mọi truy vấn vẫn chạy.
model EventBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  assignmentWorkSessionId String @db.Uuid

  /// ID ổn định do tool tạo cho mỗi batch. Gửi lại cùng batch sau khi mất mạng không được tạo
  /// thêm một dòng hay làm sequence tiến lên lần nữa.
  clientBatchId String @db.Uuid

  /// Số thứ tự sự kiện đầu và cuối của lô, trong phạm vi một buổi.
  ///
  /// Cặp này phát hiện MẤT DỮ LIỆU: `seqStart` của lô sau không nối tiếp `seqEnd` của lô trước
  /// nghĩa là có sự kiện biến mất trên đường. Cũng dùng để sắp thứ tự khi phát lại — không sắp
  /// theo thời điểm nhận, vì lô gửi lại sau khi mất mạng có thể tới muộn hơn lô kế tiếp.
  seqStart Int
  seqEnd   Int

  /// Đồng hồ MÁY NGƯỜI DÙNG, do công cụ gửi kèm.
  clientAt   DateTime
  /// Đồng hồ MÁY CHỦ. Lệch lớn giữa hai mốc là dấu hiệu đồng hồ máy người dùng bị chỉnh.
  receivedAt DateTime @default(now())

  /// Mảng sự kiện thô. Nền tảng lưu mù, không diễn giải.
  events Json

  workSession AssignmentWorkSession @relation(fields: [assignmentWorkSessionId], references: [id], onDelete: Cascade)

  @@unique([assignmentWorkSessionId, clientBatchId])
  @@index([assignmentWorkSessionId, seqStart])
}
