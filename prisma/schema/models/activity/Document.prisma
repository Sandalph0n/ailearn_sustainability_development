/// Một tài liệu trong workspace.
///
/// ─── Nội dung KHÔNG nằm ở đây ────────────────────────────────────────────────
///
/// Nội dung sống trong kho tệp, và khoá của nó CHÍNH LÀ `id` của dòng này. Vì tài liệu có thể là
/// bất cứ thứ gì — văn bản, ảnh nhúng trong sơ đồ, tệp tải lên.
///
/// Khoá kho tệp phải bất biến, nên không được dùng tên hay đường dẫn: đổi tên tệp mà phải di
/// chuyển đối tượng trong kho là sai. `name` và `parentFolderId` chỉ là metadata.
///
/// ─── Thứ tự ghi ─────────────────────────────────────────────────────────────
///
/// Ghi kho tệp TRƯỚC, ghi database SAU. Hỏng giữa chừng theo thứ tự này để lại một đối tượng mồ
/// côi — rác, quét được. Ngược lại thì để lại một dòng trỏ vào hư không, không cứu được.
model Document {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  workspaceId String @db.Uuid

  /// Tên của riêng entry này, không chứa đường dẫn hay dấu phân cách thư mục.
  /// Đường dẫn đầy đủ chỉ được dựng khi đọc bằng cách đi ngược chuỗi `parentFolder`.
  name String

  /// Root có `parentFolderId = null`; mọi entry còn lại trỏ tới đúng một folder trong cùng
  /// workspace. Quan hệ tự tham chiếu này giúp rename chỉ cập nhật một row.
  parentFolderId String? @db.Uuid

  /// Folder cũng là một entry trong bảng này, nhưng không có object tương ứng trong kho tệp.
  entryKind WorkspaceEntryKind @default(FILE)

  /// Băm nội dung tại lần lưu gần nhất. Đây là MỐC KIỂM CHỨNG: phát lại chuỗi sự kiện tới thời
  /// điểm lưu rồi băm, lệch nghĩa là đã bỏ sót sự kiện. Folder không có nội dung nên để trống.
  contentHash String?

  /// Properties lấy tại lần upload gần nhất. Folder không có MIME type hay kích thước byte.
  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentFolder Document?  @relation("DocumentHierarchy", fields: [workspaceId, parentFolderId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade)
  children     Document[] @relation("DocumentHierarchy")

  /// Khoá ghép này là đích của FK tự tham chiếu, bảo đảm cha và con luôn cùng workspace.
  @@unique([workspaceId, id])
  @@unique([workspaceId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
}

enum WorkspaceEntryKind {
  FILE
  FOLDER
}
