/// Một tài liệu trong workspace.
///
/// ─── Nội dung KHÔNG nằm ở đây ────────────────────────────────────────────────
///
/// Nội dung sống trong kho tệp, và khoá của nó CHÍNH LÀ `id` của dòng này. Vì tài liệu có thể là
/// bất cứ thứ gì — văn bản, ảnh nhúng trong sơ đồ, tệp tải lên.
///
/// Khoá kho tệp phải bất biến, nên không được dùng `displayPath`: đổi tên tệp mà phải di chuyển
/// đối tượng trong kho là sai. `displayPath` chỉ là tên hiển thị.
///
/// ─── Thứ tự ghi ─────────────────────────────────────────────────────────────
///
/// Ghi kho tệp TRƯỚC, ghi database SAU. Hỏng giữa chừng theo thứ tự này để lại một đối tượng mồ
/// côi — rác, quét được. Ngược lại thì để lại một dòng trỏ vào hư không, không cứu được.
model Document {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  workspaceId String @db.Uuid

  /// Đường dẫn hiển thị: `src/main.js`, `so-do/erd.json`. Cây thư mục dựng lại từ cột này.
  ///
  /// Phải chuẩn hoá LÚC GHI — chỉ dùng `/`, bỏ `./`, gộp `//` — và TỪ CHỐI mọi đoạn `..`:
  /// tài liệu có lúc được đổ ra hệ thống tệp thật để chạy mã.
  displayPath String

  /// Băm nội dung tại lần lưu gần nhất. Đây là MỐC KIỂM CHỨNG: phát lại chuỗi sự kiện tới thời
  /// điểm lưu rồi băm, lệch nghĩa là đã bỏ sót sự kiện.
  contentHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, displayPath])
}
