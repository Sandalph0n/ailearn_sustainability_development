/// Một công cụ làm bài: trình soạn mã, trình vẽ sơ đồ.
model Tool {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Tên bền vững, GIỐNG NHAU ở mọi môi trường: `code`, `diagram`.
  ///
  /// Cần vì UUID khác nhau ở mỗi database — mã nguồn không so được với nó. Cũng là thứ xuất hiện
  /// trong đường dẫn `/tools/<code>/…`.
  ///
  /// Không bao giờ hiện cho người dùng, nên không có lý do gì để đổi. Chữ hiển thị là `name`.
  code String @unique

  name        String
  description String?

  /// Địa chỉ mã nguồn để con người tham khảo. Gói thực thi không nằm ở đây mà thuộc từng
  /// `ToolVersion` bất biến trong bucket `tools`.
  codeBaseLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Phiên bản được chọn mặc định cho cấu hình mới. Một assessment/work session đã pin version
  /// nào thì không tự nhảy theo con trỏ này.
  activeVersionId String? @unique @db.Uuid

  activeVersion ToolVersion?            @relation("ActiveToolVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      ToolVersion[]           @relation("ToolVersions")
  assessments   AssessmentAllowTool[]
  workSessions  AssignmentWorkSession[]
}
