/// Một công cụ làm bài: trình soạn mã, trình vẽ sơ đồ.
model Tool {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Tên bền vững, GIỐNG NHAU ở mọi môi trường: `code`, `diagram`.
  ///
  /// Cần vì UUID khác nhau ở mỗi database — mã nguồn không so được với nó. Cũng là thứ xuất hiện
  /// trong đường dẫn `/tools/<code>/…`.
  ///
  /// Không bao giờ hiện cho người dùng, nên không có lý do gì để đổi. Chữ hiển thị là `name`.
  code String @unique

  name        String
  description String?

  /// Nơi chứa mã của công cụ. Chỗ để về sau nạp công cụ không nằm trong bản build.
  codeBaseLocation String?

  assessments  AssessmentAllowTool[]
  workSessions AssignmentWorkSession[]
}
