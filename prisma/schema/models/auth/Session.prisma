/// Một phiên đăng nhập của một thiết bị.
///
/// ─── Vì sao lưu phiên trong database, thay vì dùng JWT thuần ─────────────────
///
/// Vì THU HỒI được. Máy bị mất thì xoá một dòng là phiên chết ngay. JWT thuần thì token sống cho
/// tới khi hết hạn, không có cách nào chặn giữa chừng.
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Phiên này của ai.
  userId String @db.Uuid

  /// BĂM của token, KHÔNG phải token.
  ///
  /// Token thật chỉ nằm trong cookie trên máy người dùng. Rò bảng này thì kẻ tấn công vẫn không
  /// mạo danh được ai — cùng lý do với mật khẩu.
  tokenHash String @unique

  /// Quá hạn thì coi như không tồn tại, kể cả khi dòng vẫn nằm đó.
  expiresAt DateTime

  createdAt DateTime @default(now())

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
