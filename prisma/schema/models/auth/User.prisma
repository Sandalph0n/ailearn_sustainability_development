/// Một tài khoản người dùng.
///
/// Không phân biệt sinh viên hay giảng viên ở đây: vai trò thuộc về QUAN HỆ giữa người và một
/// phạm vi cụ thể — xem `RoleAssignment`.
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email        String @unique
  /// BĂM của mật khẩu. Rò bảng này thì kẻ tấn công vẫn không đăng nhập được.
  passwordHash String

  firstName String
  lastName  String

  /// Quản trị viên toàn hệ thống — người vận hành, không phải vai trò trong môn học.
  ///
  /// Mặc định `false` chứ không cho phép null: "có phải quản trị viên không" chỉ có hai câu trả
  /// lời, thêm trạng thái `null` là thêm một nhánh vô nghĩa mà mọi chỗ đọc đều phải xử lý.
  ///
  /// Mặc định an toàn theo hướng từ chối: quên gán thì thành `false`, không bao giờ vô tình
  /// thành quản trị viên.
  ///
  /// Khác hẳn `Membership.role` — cái kia là vai trò TRONG một môn, cái này là quyền vận hành
  /// toàn hệ thống.
  isSystemAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  /// Phiên đăng nhập chết theo tài khoản — chúng không có giá trị lưu trữ nào.
  loginSessions LoginSession[]

  /// Những thứ dưới đây đều `Restrict`: KHÔNG xoá được tài khoản đã có hoạt động.
  ///
  /// Với một hệ thống lấy liêm chính học thuật làm cốt lõi, cho phép xoá tài khoản là mở một
  /// đường xoá sạch bằng chứng. Muốn ngừng cho ai đó dùng thì vô hiệu hoá, không phải xoá.
  roleAssignments   RoleAssignment[]
  roleRequests      RoleRequest[]       @relation("requestedBy")
  processedRequests RoleRequest[]       @relation("processedBy")
  attempts          AssessmentAttempt[]

  /// Workspace cá nhân thì ngược lại — dữ liệu riêng, không có giá trị đối chứng, xoá theo được.
  personalWorkspaces PersonalWorkspace[]
}
