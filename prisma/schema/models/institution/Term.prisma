/// Một kỳ học của một cơ sở giáo dục, ví dụ "Session 2, 2026".
///
/// ─── Vì sao là bảng riêng chứ không phải một chuỗi trong Subject ─────────────
///
/// Vì kỳ học là thứ nhiều môn CÙNG tham chiếu tới. Nếu mỗi môn tự ghi chuỗi "S2 2026" thì sẽ có
/// môn ghi "Session 2 2026", môn ghi "2026 S2", và không cách nào lọc "mọi bài tập của kỳ này".
model Term {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Kỳ này của cơ sở nào. Lịch kỳ mỗi trường mỗi khác nên không dùng chung.
  institutionId String @db.Uuid

  /// Tên hiển thị, ví dụ "Session 2, 2026".
  name String

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// Các lượt mở môn diễn ra trong kỳ này.
  offerings Offering[]

  @@index([institutionId])
}
