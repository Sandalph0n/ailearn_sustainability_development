/// Một cơ sở giáo dục. Gốc của toàn bộ cây dữ liệu học vụ.
model Institution {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name    String
  website String?

  /// Khoá của logo trong bucket `media`. `null` = chưa đặt logo.
  ///
  /// Cùng lối với `User.avatarKey`: lưu cả khoá để đổi ảnh là đổi địa chỉ.
  logoKey String?

  roles        Role[]
  studyTerms   StudyTerm[]
  subjects     Subject[]
  roleRequests RoleRequest[]
}
