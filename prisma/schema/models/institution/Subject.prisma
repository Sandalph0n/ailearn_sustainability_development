/// Một môn học. KHÔNG gắn với kỳ — môn tồn tại qua nhiều năm.
///
/// Việc "môn này được mở kỳ nào" thuộc về `Offering`.
model Subject {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  institutionId String @db.Uuid

  subjectCode        String
  subjectName        String
  subjectDescription String?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  offerings   Offering[]

  /// Mã môn chỉ cần duy nhất TRONG một cơ sở — hai trường đều có thể có "COMP1000".
  @@unique([institutionId, subjectCode])
}
