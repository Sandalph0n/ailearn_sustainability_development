/// Một vai trò do MỘT cơ sở định nghĩa.
///
/// Không dùng chung giữa các cơ sở: "Trợ giảng" của trường A và của trường B có thể được cấp
/// những quyền khác hẳn nhau.
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  institutionId String @db.Uuid

  roleName String

  /// Biểu thức khớp email để TỰ ĐỘNG cấp vai trò lúc gia nhập, không cần ai duyệt.
  ///
  /// Khớp thì vào thẳng; không khớp thì phải qua `RoleRequest` và chờ người duyệt. Đây là lối
  /// tắt để không phải duyệt tay hàng nghìn sinh viên mỗi kỳ.
  ///
  /// Chỉ có nghĩa với vai trò phạm vi INSTITUTION — ánh xạ email xảy ra lúc vào TRƯỜNG, khi chưa
  /// có lượt mở môn nào để nói tới. Database không kiểm được điều đó, phải kiểm bằng mã.
  autoGrantEmailRegex String?

  /// Vai trò này gán ở tầng nào. Quyết định `RoleAssignment.offeringId` phải rỗng hay phải có.
  scopeType RoleScopeType

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// Các cạnh của đồ thị kế thừa quyền.
  ///
  /// Một vai trò có thể bao gồm nhiều vai trò và đồng thời được nhiều vai trò khác bao gồm.
  /// Diamond hợp lệ; chu trình bị trigger trong migration chặn để phép duyệt quyền luôn dừng.
  includedRoles RoleInclusion[] @relation("includingRole")
  parentRoles   RoleInclusion[] @relation("includedRole")

  permissions     RolePermission[]
  /// `Restrict`: còn ai đang giữ vai trò này thì không xoá được nó.
  roleAssignments RoleAssignment[]
  roleRequests    RoleRequest[]

  @@index([institutionId])
}

/// Vai trò gán ở tầng nào.
enum RoleScopeType {
  /// Gán cho cả cơ sở. `RoleAssignment.offeringId` phải rỗng.
  INSTITUTION

  /// Gán cho một lượt mở môn cụ thể. `RoleAssignment.offeringId` bắt buộc có.
  OFFERING
}
