/// Một vai trò do MỘT cơ sở định nghĩa.
///
/// Không dùng chung giữa các cơ sở: "Trợ giảng" của trường A và của trường B có thể được cấp
/// những quyền khác hẳn nhau.
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  institutionId String @db.Uuid

  /// Mã ổn định dùng trong cấu hình và audit. Prefix phải khớp `scopeType`, ví dụ
  /// `institution:subject.manager` hoặc `offering:subject.manager`.
  roleCode String

  /// Nhãn dễ đọc được hiển thị trong giao diện.
  roleName String

  /// Biểu thức khớp email để TỰ ĐỘNG cấp vai trò lúc gia nhập, không cần ai duyệt.
  ///
  /// Khớp thì vào thẳng; không khớp thì chỉ có thể qua `RoleRequest` nếu `requestMode` cho phép.
  /// Đây là lối tắt để không phải duyệt tay hàng nghìn sinh viên mỗi kỳ.
  ///
  /// Áp dụng cho cả INSTITUTION và OFFERING. Role OFFERING được tự cấp ở trạng thái chưa có
  /// ScopeAssignment; quyền trên từng offering chỉ có hiệu lực sau khi được gắn scope.
  autoGrantEmailRegex String?

  /// Vai trò này có hiệu lực ở tầng nào. OFFERING role lấy các scope từ `ScopeAssignment` và có
  /// thể tạm thời chưa được gắn scope nào.
  scopeType RoleScopeType

  /// Quy định role có thể được người dùng tự gửi yêu cầu hay chỉ được quản trị viên cấp.
  /// `CONDITIONAL` dùng các dòng `RoleRequestVisibility` theo phép OR.
  requestMode RoleRequestMode @default(DISABLED)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// Các cạnh của đồ thị kế thừa quyền.
  ///
  /// Một vai trò có thể bao gồm nhiều vai trò và đồng thời được nhiều vai trò khác bao gồm.
  /// Diamond hợp lệ; chu trình bị trigger trong migration chặn để phép duyệt quyền luôn dừng.
  includedRoles RoleInclusion[] @relation("includingRole")
  parentRoles   RoleInclusion[] @relation("includedRole")

  permissions            RolePermission[]
  /// Điều kiện để role này xuất hiện trong danh sách xin quyền.
  requestVisibilityRules RoleRequestVisibility[] @relation("requestableRole")
  /// Những role khác được mở khóa để nhìn thấy nhờ việc người dùng giữ role này.
  unlocksRoleRequests    RoleRequestVisibility[] @relation("requiredRole")
  /// `Restrict`: còn ai đang giữ vai trò này thì không xoá được nó.
  roleAssignments        RoleAssignment[]
  roleRequests           RoleRequest[]

  @@unique([institutionId, roleCode])
  @@index([institutionId])
}

/// Vai trò gán ở tầng nào.
enum RoleScopeType {
  /// Có hiệu lực trên toàn cơ sở và không có dòng `ScopeAssignment`.
  INSTITUTION

  /// Có hiệu lực trên các offering nằm trong `ScopeAssignment`. Không có dòng scope
  /// nào nghĩa là người dùng mới có role identity, chưa được cấp quyền trên offering nào.
  OFFERING
}

/// Chính sách tự xin một role. Đây là authorization policy, không chỉ là trạng thái hiển thị UI.
enum RoleRequestMode {
  /// Không thể tự xin; chỉ người có quyền mới được cấp trực tiếp.
  DISABLED

  /// Mọi người dùng đã đăng nhập đều có thể nhìn thấy và gửi request.
  PUBLIC

  /// Chỉ người đang giữ ít nhất một role trong `RoleRequestVisibility` mới được request.
  CONDITIONAL
}
