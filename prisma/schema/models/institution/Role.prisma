/// Một vai trò do MỘT cơ sở định nghĩa.
///
/// Không dùng chung giữa các cơ sở: "Trợ giảng" của trường A và của trường B có thể được cấp
/// những quyền khác hẳn nhau.
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  institutionId String @db.Uuid

  roleName String

  /// Biểu thức khớp email để tự động gán vai trò lúc gia nhập.
  ///
  /// Chỉ có nghĩa với vai trò phạm vi INSTITUTION — ánh xạ email xảy ra lúc vào TRƯỜNG, không
  /// phải lúc vào một lớp. Database không kiểm được điều đó, phải kiểm bằng mã.
  emailRegex String?

  /// Vai trò này gán ở tầng nào. Quyết định `RoleAssignment.offeringId` phải rỗng hay phải có.
  scopeType RoleScopeType

  /// Vai trò bao gồm vai trò khác — "Phụ trách môn" bao gồm "Trợ giảng".
  ///
  /// Cây, không phải đồ thị: mỗi vai trò nhiều nhất một cha. `SetNull` vì xoá vai trò cha thì
  /// vai trò con vẫn tồn tại, chỉ mất phần kế thừa.
  includedById String? @db.Uuid

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  includedBy  Role?       @relation("roleHierarchy", fields: [includedById], references: [id], onDelete: SetNull)
  includes    Role[]      @relation("roleHierarchy")

  permissions     RolePermission[]
  /// `Restrict`: còn ai đang giữ vai trò này thì không xoá được nó.
  roleAssignments RoleAssignment[]
  roleRequests    RoleRequest[]

  @@index([institutionId])
}

/// Vai trò gán ở tầng nào.
enum RoleScopeType {
  /// Gán cho cả cơ sở. `RoleAssignment.offeringId` phải rỗng.
  INSTITUTION

  /// Gán cho một lượt mở môn cụ thể. `RoleAssignment.offeringId` bắt buộc có.
  OFFERING
}
