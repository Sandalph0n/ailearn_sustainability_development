/// Một người giữ một vai trò. Phạm vi offering được lưu riêng vì một assignment có thể áp dụng
/// cho nhiều lượt mở môn.
///
/// ─── Vì sao có khoá thay thế thay vì khoá tổ hợp ─────────────────────────────
///
/// Assignment có lịch sử cấp/thu hồi và có thể được một RoleRequest tham chiếu, nên cần `id`
/// riêng thay vì dùng `(userId, roleId)` làm khoá chính.
///
/// ─── Phạm vi suy ra từ vai trò ───────────────────────────────────────────────
///
/// Không có cột `institutionId`: `Role` đã thuộc về một cơ sở rồi. Lưu thêm lần nữa là hai nguồn
/// sự thật, và chúng lệch nhau được.
model RoleAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  /// Ai cấp assignment này mà không đi qua RoleRequest.
  /// Rỗng khi assignment được sinh ra từ một request đã duyệt.
  grantDirectlyById String? @db.Uuid

  roleGrantedAt DateTime  @default(now())
  roleRevokedAt DateTime?

  user            User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantDirectlyBy User? @relation("directRoleGrants", fields: [grantDirectlyById], references: [id], onDelete: Restrict)

  /// Rỗng với role INSTITUTION hoặc role OFFERING chưa được scope. Mỗi dòng lưu cả offering và
  /// nguồn đã cấp scope đó (trực tiếp hoặc bằng code).
  scopeAssignments ScopeAssignment[]

  /// Đơn xin đã tạo ra phép gán này, nếu có.
  fromRequest RoleRequest?

  @@index([userId])
  @@index([roleId])
  @@index([grantDirectlyById])
}
