/// Một người tham gia một lượt mở môn, KÈM vai trò.
///
/// ─── Vì sao không có bảng `Student` và bảng `Staff` riêng ────────────────────
///
/// Vì vai trò không thuộc về con người, nó thuộc về QUAN HỆ giữa người và môn. Cùng một người có
/// thể là sinh viên môn này và trợ giảng môn khác trong cùng một kỳ — chuyện rất thường ở bậc
/// sau đại học.
///
/// Tách thành hai bảng thì người đó phải có hai tài khoản, và mọi truy vấn "ai đang xem bài này"
/// đều phải hỏi cả hai nơi.
model Membership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Ai.
  userId String @db.Uuid

  /// Tham gia lượt mở môn nào.
  offeringId String @db.Uuid

  /// Với vai trò gì. Quyết định họ nộp bài hay chấm bài.
  role MemberRole

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  /// Một người chỉ có MỘT vai trò trong một lượt mở môn.
  @@unique([userId, offeringId])
  @@index([offeringId])
}

/// Vai trò trong một lượt mở môn.
enum MemberRole {
  /// Làm bài và nộp.
  STUDENT

  /// Chấm bài. Không nộp bài của môn này.
  TUTOR

  /// Phụ trách môn: chấm bài, và là người tạo ra các bài tập.
  CONVENOR
}
