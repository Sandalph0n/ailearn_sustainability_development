/// Một LƯỢT MỞ MÔN: môn X dạy trong kỳ Y. Đây là thứ người ta thật sự tham gia.
///
/// Mọi thứ có thật đều thuộc về lượt mở, không thuộc về môn: bài tập, hạn nộp, danh sách lớp,
/// giảng viên. Cùng một môn mở ở hai kỳ là hai lượt hoàn toàn tách biệt.
///
/// ─── Vì sao có khoá thay thế ─────────────────────────────────────────────────
///
/// Khoá thay thế giúp các bảng assessment và scope của role assignment tham chiếu một offering
/// bằng đúng một cột ổn định.
model Offering {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  subjectId String @db.Uuid
  termId    String @db.Uuid

  subject Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    StudyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  assessments             Assessment[]
  scopeAssignments        ScopeAssignment[]
  scopeAssignmentCodes    ScopeAssignmentCode[]
  scopeAssignmentRequests ScopeAssignmentRequest[]
  calendarEvents          CalendarEvent[]

  /// Một môn chỉ mở một lần trong một kỳ.
  @@unique([subjectId, termId])
  @@index([termId])
}
