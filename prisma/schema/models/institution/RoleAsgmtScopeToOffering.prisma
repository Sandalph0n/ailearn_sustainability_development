/// Phạm vi many-to-many giữa một role assignment và các offering nơi role đó có hiệu lực.
model RoleAsgmtScopeToOffering {
  roleAssignmentId String @db.Uuid
  offeringId       String @db.Uuid

  roleAssignment RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  /// `Restrict`: không được xoá offering làm mất lịch sử phạm vi của assignment.
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([roleAssignmentId, offeringId])
  @@index([offeringId])
}
