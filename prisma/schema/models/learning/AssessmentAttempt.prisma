/// Một LƯỢT LÀM BÀI của một sinh viên cho một bài tập.
///
/// Một lượt trải qua NHIỀU buổi ngồi máy, cách nhau nhiều ngày — buổi không phải lượt.
///
/// Một người có thể bắt đầu nhiều lượt cho cùng một bài. Giới hạn số lượt là chính sách tương
/// lai, không phải ràng buộc hiện tại, nên mỗi lượt có khoá riêng thay vì dùng cặp
/// `(userId, assessmentId)` làm khoá.
model AssessmentAttempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId       String @db.Uuid
  assessmentId String @db.Uuid

  startAt DateTime @default(now())

  /// Rỗng = đang làm dở. Sau thời điểm này bài chuyển sang chỉ đọc, và mọi thao tác ghi nhận
  /// được sau đó đều đáng chú ý.
  submitAt DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  workspace AssignmentWorkspace?

  @@index([userId, assessmentId])
  @@index([assessmentId])
}
