/// Một bài tập của một lượt mở môn.
///
/// Gắn với LƯỢT MỞ chứ không phải môn — đề bài và hạn nộp kỳ này khác kỳ trước.
model Assessment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  offeringId String @db.Uuid

  name        String
  description String?

  /// Trọng số phần trăm. Tổng của một lượt mở môn phải bằng 100 — luật nghiệp vụ, mã kiểm.
  weight Float

  /// Điều kiện bắt buộc: trượt bài này là trượt môn, dù tổng điểm đủ. Không tham gia phép tính
  /// trọng số — nó là một cửa riêng.
  hurdle Boolean @default(false)

  /// Bài nhóm: một lượt làm bài, nhiều người cùng đóng góp.
  isGroup Boolean @default(false)

  /// Rỗng = chưa công bố, sinh viên chưa thấy.
  publishAt DateTime?
  dueAt     DateTime

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  allowedTools AssessmentAllowTool[]
  /// `Restrict`: còn bài làm của sinh viên thì không xoá được bài tập.
  attempts     AssessmentAttempt[]

  @@index([offeringId])
}
