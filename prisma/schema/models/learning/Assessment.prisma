/// Một bài tập của một lượt mở môn.
model Assessment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Thuộc lượt mở môn nào. Bài tập gắn với LƯỢT MỞ chứ không gắn với môn — xem `Offering`.
  offeringId String @db.Uuid

  /// Tên bài tập hiển thị cho sinh viên.
  title String

  /// Hạn nộp. Cũng là thứ hệ thống lịch đọc để dựng nhắc nhở.
  dueAt DateTime

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  /// Những công cụ sinh viên được phép dùng cho bài này.
  ///
  /// Quan hệ nhiều-nhiều: một bài có thể cho dùng vài công cụ, một công cụ dùng cho nhiều bài.
  /// Prisma tự dựng bảng nối, ta không cần khai.
  tools Tool[]

  /// Các lượt làm bài của sinh viên.
  attempts Attempt[]

  @@index([offeringId])
}
