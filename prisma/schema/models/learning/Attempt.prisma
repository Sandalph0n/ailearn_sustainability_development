/// Một LƯỢT LÀM BÀI của một sinh viên cho một bài tập.
///
/// ─── Vì sao tách khỏi `WorkSession` ──────────────────────────────────────────
///
/// Vì một lượt làm bài trải qua NHIỀU buổi ngồi máy. Sinh viên làm hai tiếng tối nay, ba tiếng
/// tối mai — đó là hai `WorkSession`, nhưng cùng một `Attempt`.
///
/// Đây cũng là đơn vị được CHẤM: giảng viên chấm một lượt làm bài, không chấm từng buổi.
model Attempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Làm bài tập nào.
  assessmentId String @db.Uuid

  /// Ai làm.
  userId String @db.Uuid

  startedAt DateTime @default(now())

  /// Nộp lúc nào. `null` = đang làm dở.
  ///
  /// Đây là ranh giới: sau thời điểm này giảng viên mới chấm, và những gì ghi nhận thêm sau đó
  /// đều đáng chú ý.
  submittedAt DateTime?

  // ─── Quan hệ ─────────────────────────────────────────────────────────────

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Các buổi ngồi làm thuộc lượt này.
  workSessions WorkSession[]

  /// Các lần chấm. Nhiều lần là bình thường — xem `Marking`.
  markings Marking[]

  @@index([assessmentId])
  @@index([userId])
}
